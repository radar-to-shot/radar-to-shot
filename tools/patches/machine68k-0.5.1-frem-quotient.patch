+/* Motorola FREM/FMOD record the quotient sign and low seven magnitude bits in
+ * FPSR[23:16]. SoftFloat returns the IEEE remainder but not that quotient.
+ * Compute it from the exact extended significands, without narrowing either
+ * operand to binary64 or overflowing an integer quotient. */
+static unsigned int rw_remainder_quotient(floatx80 a, floatx80 b, int nearest)
+{
+    uint64 numerator = a.low, denominator = b.low, remainder = 0;
+    int ae = a.high & 0x7fff, be = b.high & 0x7fff;
+    int shift, bit;
+    unsigned int q = 0;
+    unsigned int sign = ((a.high ^ b.high) & 0x8000) ? 0x80 : 0;
+    if (ae == 0x7fff || be == 0x7fff || !denominator || !numerator)
+        return sign;
+    if (!ae) ae = 1;
+    if (!be) be = 1;
+    while (!(numerator >> 63)) { numerator <<= 1; --ae; }
+    while (!(denominator >> 63)) { denominator <<= 1; --be; }
+    shift = ae - be;
+    if (shift < 0) {
+        /* Both significands are normalized: the truncated quotient is zero.
+         * Only a one-bit exponent gap can round above one half. */
+        if (nearest && shift == -1 && numerator > denominator) q = 1;
+        return sign | q;
+    }
+    for (bit = shift + 63; bit >= 0; --bit) {
+        unsigned int carry = (unsigned int)(remainder >> 63);
+        unsigned int digit = bit >= shift ? (unsigned int)((numerator >> (bit-shift)) & 1) : 0;
+        remainder = (remainder << 1) | digit;
+        digit = carry || remainder >= denominator;
+        if (digit) remainder -= denominator;
+        q = ((q << 1) | digit) & 0x7f;
+    }
+    if (nearest && (remainder > denominator/2 ||
+            (!(denominator & 1) && remainder == denominator/2 && (q & 1))))
+        q = (q + 1) & 0x7f;
+    return sign | q;
+}
+
+static floatx80 rw_remainder(floatx80 a, floatx80 b, int nearest)
+{
+    floatx80 result = floatx80_rem(a, b);
+    REG_FPSR = (REG_FPSR & ~0x00ff0000u) |
+               (rw_remainder_quotient(a, b, nearest) << 16);
+    /* FMOD truncates the quotient; IEEE remainder uses nearest-even. If its
+     * nonzero remainder has the opposite sign, undo that final rounding. */
+    if (!nearest && result.low && (result.high & 0x7fff) != 0x7fff &&
+            ((result.high ^ a.high) & 0x8000)) {
+        b.high = (b.high & 0x7fff) | (a.high & 0x8000);
+        result = floatx80_add(result, b);
+    }
+    return result;
+}
+
+/* Bridge SoftFloat's per-operation exception reports to the 68881 FPSR.
+ * Control-register moves must not synthesize exceptions from stale SoftFloat
+ * flags. Arithmetic/conversion instructions clear current status, while
+ * accrued exception bits remain sticky until software writes FPSR. */
+static void rw_fp_begin(void)
+{
+    float_exception_flags = 0;
+    REG_FPSR &= ~0x0000ff00u;
+}
+
+static void rw_fp_end(void)
+{
+    unsigned int flags = (unsigned char)float_exception_flags;
+    if (flags & float_flag_invalid)   REG_FPSR |= 0x00002080u;
+    if (flags & float_flag_divbyzero) REG_FPSR |= 0x00000410u;
+    if (flags & float_flag_overflow)  REG_FPSR |= 0x00001048u;
+    if (flags & float_flag_underflow) {
+        REG_FPSR |= 0x00000800u;
+        if (flags & float_flag_inexact) REG_FPSR |= 0x00000020u;
+    }
+    if (flags & float_flag_inexact)   REG_FPSR |= 0x00000208u;
+}
 
