; @author: OpenAI Codex GPT 6 Astra
; @author-id: openai-codex-gpt-6-astra
; @name: Parallax
; @robot-id: parallax
; @version: 1.0.0
;
; Derived from Radar Hawk by Sonnet 5.5 (robots/model_bench_20261111/sonnet55.bot).
; Prediction, battle-size policy, timer isolation and validation: OpenAI Codex.
; See docs/PARALLAX.md for tactics, attribution and reproducible benchmarks.
;
; Six hardware points: CPU 2, fire 2, cloak 1, fuel 1.
; Angles are degrees clockwise from north; fixed-point positions/velocities use 16.
; Arithmetic evaluates left to right; do not apply ordinary operator precedence.

CPU_SPEED 2
RADAR_RANGE 0
FIRE_RATE 2
CLOAKING 1
FUEL_CAPACITY 1
ENGINE_SIZE 0
ARMOR 0
ALLOCATE ropt
ALLOCATE cloakd
DEFINE spdhi 19
DEFINE spdlo 19
DEFINE spdc 9
ALLOCATE cloakt
DEFINE lostd 0
DEFINE neard 100
DEFINE nearw 0
DEFINE bmin 4
DEFINE bmax 8
DEFINE patw 150

ALLOCATE firetime
ALLOCATE fireflight
ALLOCATE firetries
ALLOCATE cheading
ALLOCATE coldheading
ALLOCATE cspeed
ALLOCATE cturn
ALLOCATE csweep
ALLOCATE cscale
ALLOCATE ctest
ALLOCATE accelerationx
ALLOCATE accelerationy
ALLOCATE previousvx
ALLOCATE previousvy
ALLOCATE velocitytime
ALLOCATE deltatime
ALLOCATE leadcurve
ALLOCATE isrtmp
ALLOCATE accstrength
ALLOCATE clock
ALLOCATE dh
ALLOCATE sg
ALLOCATE turncnt
ALLOCATE spd
ALLOCATE cloakuntil
ALLOCATE lastdmg
ALLOCATE havetrack
ALLOCATE fixes
ALLOCATE misses
ALLOCATE tclock
ALLOCATE tx
ALLOCATE ty
ALLOCATE vx
ALLOCATE vy
ALLOCATE ax
ALLOCATE ay
ALLOCATE at
ALLOCATE lx
ALLOCATE ly
ALLOCATE lt
ALLOCATE sa
ALLOCATE sw
ALLOCATE r
ALLOCATE rr
ALLOCATE q
ALLOCATE c
ALLOCATE h
ALLOCATE lo
ALLOCATE hi
ALLOCATE mid
ALLOCATE mx
ALLOCATE my
ALLOCATE fclock
ALLOCATE zx
ALLOCATE zy
ALLOCATE dt
ALLOCATE dta
ALLOCATE px
ALLOCATE py
ALLOCATE pb
ALLOCATE pd
ALLOCATE tt
ALLOCATE kk
ALLOCATE dq
ALLOCATE ad
ALLOCATE ldx
ALLOCATE ldy
ALLOCATE ux
ALLOCATE uy
ALLOCATE fx
ALLOCATE fy
ALLOCATE ar
ALLOCATE tmp
ALLOCATE nshots
ALLOCATE lastnum
ALLOCATE lastnear
ALLOCATE nfix
ALLOCATE wpi
ALLOCATE wx
ALLOCATE wy
ALLOCATE lasttrack
ALLOCATE wpt
ALLOCATE stm
ALLOCATE patinit

    IF NUM_ROBOTS > 1 THEN
        135 TO ropt
        90 TO cloakd
        4 TO accstrength
        27 TO cloakt
    ELSE
        120 TO ropt
        130 TO cloakd
        6 TO accstrength
        18 TO cloakt
    END
    tick_isr TO TIME_INT_XFER
    NUM_ROBOTS TO lastnum
    1 TO sg
    19 TO spd
    spd TO SPEED
    1 TO TIME_INT_MASK
main
    IF havetrack = 0 THEN
        GOSUB search
    ELSE
        GOSUB track
    END
GOTO main

search
    GOSUB seekcenter
    sa + 5 MOD 360 TO sa
    sa TO RADAR
    RADAR TO r
    IF r > 0 THEN GOSUB newtrack
RETURN

seekcenter
    clock - lasttrack TO stm
    190 TO wx
    156 TO wy
    IF stm >= patw THEN
        IF patinit = 0 THEN GOSUB pickwp
        GOSUB waypoint
    END
    wx - X TO X_CONV
    wy - Y TO Y_CONV
    ANGLE_CONV TO dh
    19 TO spd
    IF DIST_CONV < 40 THEN 9 TO spd
    IF stm >= patw THEN
        IF DIST_CONV < 35 THEN GOSUB nextwp
        IF clock - wpt > 160 THEN GOSUB nextwp
    END
RETURN

pickwp
    IF X < 190 THEN
        IF Y < 156 THEN
            0 TO wpi
        ELSE
            3 TO wpi
        END
    ELSE
        IF Y < 156 THEN
            1 TO wpi
        ELSE
            2 TO wpi
        END
    END
    clock TO wpt
    1 TO patinit
RETURN

; Visit all four quadrants after a long search, including corner campers.
waypoint
    IF wpi = 0 THEN
        65 TO wx
        65 TO wy
    END
    IF wpi = 1 THEN
        316 TO wx
        65 TO wy
    END
    IF wpi = 2 THEN
        316 TO wx
        248 TO wy
    END
    IF wpi = 3 THEN
        65 TO wx
        248 TO wy
    END
RETURN

nextwp
    wpi + 1 MOD 4 TO wpi
    clock TO wpt
RETURN

newtrack
    GOSUB waittick
    sa TO RADAR
    RADAR TO r
    IF r > 0 THEN
        GOSUB refine
        GOSUB fixpos
        0 TO fixes
        GOSUB update
        0 TO misses
        c TO pb
        r TO pd
        1 TO havetrack
    END
RETURN

waittick
    clock TO kk
    WHILE clock = kk DO
        kk TO tmp
    END
    X TO mx
    Y TO my
    clock TO fclock
RETURN

; Find the radar cone edge, then recover its center bearing.
refine
    310 / r + 1 TO h
    IF h > 32 THEN 32 TO h
    0 - h - h + sa - 1 TO lo
    sa TO hi
    WHILE hi - lo > 1 DO
        hi + lo / 2 TO mid
        mid TO RADAR
        RADAR TO q
        IF q > 0 THEN
            mid TO hi
        ELSE
            mid TO lo
        END
    END
    hi + h + 360 MOD 360 TO c
RETURN

fixpos
    c TO ANGLE_CONV
    r TO DIST_CONV
    X_CONV + mx * 16 TO zx
    Y_CONV + my * 16 TO zy
    nfix + 1 TO nfix
RETURN

; Velocity estimates span 4-8 ticks. Acceleration uses the interval between
; the MIDPOINTS of those velocity windows, stored at twice tick resolution.
update
    IF fixes = 0 THEN
        zx TO ax
        zy TO ay
        fclock TO at
        0 TO vx
        0 TO vy TO accelerationx TO accelerationy
        fclock * 2 - dta TO velocitytime
    ELSE
        fclock - at TO dta
        IF dta >= bmin THEN
            vx TO previousvx
            vy TO previousvy
            zx - ax / dta TO vx
            zy - ay / dta TO vy
            IF vx > 70 THEN 70 TO vx
            IF vx < -70 THEN -70 TO vx
            IF vy > 70 THEN 70 TO vy
            IF vy < -70 THEN -70 TO vy
            fclock * 2 - dta - velocitytime TO deltatime
            IF deltatime > 0 THEN
                vx - previousvx * 2 / deltatime TO accelerationx
                vy - previousvy * 2 / deltatime TO accelerationy
            END
            fclock * 2 - dta TO velocitytime
            IF accelerationx > accstrength THEN accstrength TO accelerationx
            0 - accstrength TO leadcurve
            IF accelerationx < leadcurve THEN leadcurve TO accelerationx
            IF accelerationy > accstrength THEN accstrength TO accelerationy
            IF accelerationy < leadcurve THEN leadcurve TO accelerationy

        END
        IF dta >= bmax THEN
            lx TO ax
            ly TO ay
            lt TO at
        END
    END
    zx TO lx
    zy TO ly
    fclock TO lt
    zx TO tx
    zy TO ty
    fclock TO tclock
    IF fixes < 30 THEN fixes + 1 TO fixes
RETURN

track
    clock TO lasttrack
    0 TO patinit
    clock - tclock TO dt
    IF dt > 45 THEN
        0 TO havetrack
        RETURN
    END
    IF dt < 3 THEN
        GOSUB fire_ctl
        GOSUB bgscan
        RETURN
    END
    dt + 1 TO tt
    vx * tt + tx TO px
    vy * tt + ty TO py
    GOSUB clampp
    px / 16 - X TO ldx
    py / 16 - Y TO ldy
    ldx TO X_CONV
    ldy TO Y_CONV
    ANGLE_CONV TO pb
    DIST_CONV TO pd
    GOSUB waittick
    GOSUB seek
    IF r > 0 THEN
        GOSUB refine
        GOSUB fixpos
        GOSUB update
        0 TO misses
        IF r < cloakd THEN clock + cloakt TO cloakuntil
        IF r < neard THEN clock TO lastnear
    ELSE
        misses + 1 TO misses
        IF fixes > 3 THEN
            IF pd < lostd THEN clock + cloakt TO cloakuntil
        END
        GOSUB wide
        IF r > 0 THEN
            GOSUB refine
            GOSUB fixpos
            GOSUB update
            0 TO misses
            IF r < cloakd THEN clock + cloakt TO cloakuntil
            IF r < neard THEN clock TO lastnear
        IF r < neard THEN clock TO lastnear
        END
    END
    GOSUB fire_ctl
    IF misses > 2 THEN GOSUB bgscan
    GOSUB steer
RETURN

seek
    pb TO sa
    sa TO RADAR
    RADAR TO r
    GOSUB gate
    IF r > 0 THEN RETURN
    4 TO kk
    WHILE kk < 13 DO
        pb + kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        pb + 360 - kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        kk + 4 TO kk
    END
RETURN

wide
    IF misses < 2 THEN
        -1 TO r
        RETURN
    END
    16 TO kk
    WHILE kk < 49 DO
        pb + kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        pb + 360 - kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        kk + 6 TO kk
    END
RETURN

gate
    IF r > 0 THEN
        r - pd TO dq
        IF dq < 0 THEN 0 - dq TO dq
        IF dq > 50 THEN -1 TO r
    END
RETURN

clampp
    IF px < 80 THEN 80 TO px
    IF px > 6016 THEN 6016 TO px
    IF py < 80 THEN 80 TO py
    IF py > 4928 THEN 4928 TO py
RETURN

cloakctl
    IF pd < cloakd THEN
        IF misses < 4 THEN clock + 20 TO cloakuntil
    END
RETURN

; Orbit the target, reverse direction periodically, and repel from walls.
steer
    IF pd < 1 THEN 1 TO pd
    ldx * 64 / pd TO ux
    ldy * 64 / pd TO uy
    pd - ropt TO ar
    IF ar > 64 THEN 64 TO ar
    IF ar < -64 THEN -64 TO ar
    spdhi TO spd
    IF ar < 30 THEN
        IF ar > -30 THEN spdlo TO spd
    END
    IF FUEL < 300 THEN
        IF spd > 19 THEN 19 TO spd
    END
    ux * ar / 64 TO fx
    uy * ar / 64 TO fy
    0 - uy * sg * 40 / 64 + fx TO fx
    ux * sg * 40 / 64 + fy TO fy
    IF X < 70 THEN 70 - X * 2 + fx TO fx
    IF X > 311 THEN
        X - 311 * 2 TO tmp
        fx - tmp TO fx
    END
    IF Y < 70 THEN 70 - Y * 2 + fy TO fy
    IF Y > 243 THEN
        Y - 243 * 2 TO tmp
        fy - tmp TO fy
    END
    fx TO X_CONV
    fy TO Y_CONV
    ANGLE_CONV TO dh
RETURN

bgscan
    0 TO kk
    WHILE kk < 3 DO
        sw + 5 MOD 360 TO sw
        sw TO RADAR
        RADAR TO rr
        IF rr > 0 THEN GOSUB contact
        kk + 1 TO kk
    END
RETURN

contact
    IF rr < neard THEN clock TO lastnear
    IF misses > 2 THEN
        sw TO sa
        rr TO r
        GOSUB newtrack
        RETURN
    END
    sw - pb + 540 MOD 360 - 180 TO ad
    IF ad < 0 THEN 0 - ad TO ad
    IF ad < 15 THEN RETURN
    IF rr + 25 < pd THEN
        sw TO sa
        rr TO r
        GOSUB newtrack
    END
RETURN

; Duels: choose a circular model for a fresh turning target, otherwise use
; bounded acceleration. Recompute if CPU work crosses a world tick.
fire_ctl
    IF NUM_ROBOTS > 1 THEN GOTO crowd_fire
    IF SHOT > 0 THEN RETURN
    IF fixes < 3 THEN RETURN
    IF misses > 11 THEN RETURN
    previousvx TO X_CONV
    previousvy TO Y_CONV
    ANGLE_CONV TO coldheading
    vx TO X_CONV
    vy TO Y_CONV
    ANGLE_CONV TO cheading
    DIST_CONV TO cspeed
    0 TO cturn
    IF deltatime > 0 THEN
        cheading - coldheading + 540 MOD 360 - 180 * 8 / deltatime TO cturn
    END
    IF cturn > 40 THEN 40 TO cturn
    IF cturn < -40 THEN -40 TO cturn
    pd / 18 + 1 TO fireflight
    0 TO firetries
fire_again
    clock TO firetime
    clock - tclock TO dt
    fireflight + dt TO tt
    GOSUB fire_predict
    IF clock <> firetime THEN
        IF firetries < 2 THEN
            firetries + 1 TO firetries
            DIST_CONV / 18 + 1 TO fireflight
            GOTO fire_again
        END
    END
    IF DIST_CONV < 22 THEN RETURN
    ANGLE_CONV TO AIM
    DIST_CONV TO SHOT
    nshots + 1 TO nshots
RETURN

fire_predict
    cturn TO ctest
    IF ctest < 0 THEN 0 - ctest TO ctest
    IF dt < 5 THEN
        IF cspeed > 16 THEN
            IF ctest >= 4 THEN GOTO circle_predict
        END
    END
    vx * tt + tx TO px
    vy * tt + ty TO py
    IF dt < 5 THEN
        tt + dta * tt / 2 TO leadcurve
        accelerationx * leadcurve + px TO px
        accelerationy * leadcurve + py TO py
    END
    GOSUB clampp
    px / 16 - X TO X_CONV
    py / 16 - Y TO Y_CONV
RETURN

circle_predict
    tt * cturn / 4 TO csweep
    IF csweep > 160 THEN 160 TO csweep
    IF csweep < -160 THEN -160 TO csweep
    csweep * csweep / 800 TO cscale
    100 - cscale TO cscale
    tt + dta * cturn / 8 + cheading TO ANGLE_CONV
    cspeed * tt / 16 * cscale / 100 TO DIST_CONV
    X_CONV * 16 + tx TO px
    Y_CONV * 16 + ty TO py
    GOSUB clampp
    px / 16 - X TO X_CONV
    py / 16 - Y TO Y_CONV
RETURN

; Crowded battles: bounded acceleration without a turn fit reduces errors
; when radar picks up a different nearby target. Correct flight range twice.
crowd_fire
    IF SHOT > 0 THEN RETURN
    IF fixes < 3 THEN RETURN
    IF misses > 11 THEN RETURN
    clock - tclock TO dt
    pd / 18 + 1 + dt TO tt
    vx * tt + tx TO px
    vy * tt + ty TO py
    IF dt < 5 THEN
        tt + dta * tt / 2 TO leadcurve
        accelerationx * leadcurve + px TO px
        accelerationy * leadcurve + py TO py
    END
    GOSUB clampp
    px / 16 - X TO X_CONV
    py / 16 - Y TO Y_CONV
    DIST_CONV / 18 + 1 + dt TO tt
    vx * tt + tx TO px
    vy * tt + ty TO py
    IF dt < 5 THEN
        tt + dta * tt / 2 TO leadcurve
        accelerationx * leadcurve + px TO px
        accelerationy * leadcurve + py TO py
    END
    GOSUB clampp
    px / 16 - X TO X_CONV
    py / 16 - Y TO Y_CONV
    IF DIST_CONV < 22 THEN RETURN
    ANGLE_CONV TO AIM
    DIST_CONV TO SHOT
    nshots + 1 TO nshots
RETURN

; Interrupts preserve the accumulator, not scratch memory or conversion registers.
; Only isrtmp is used as scratch here; main-loop tmp must remain untouched.
; Change range, cloak duration and acceleration limits as opponents disappear.
tick_isr
    clock + 1 TO clock
    turncnt - 1 TO turncnt
    IF turncnt <= 0 THEN
        0 - sg TO sg
        20 TO RANDOM
        RANDOM + 10 TO turncnt
    END
    IF DAMAGE <> lastdmg THEN
        DAMAGE TO lastdmg
        clock + cloakt TO cloakuntil
    END
    IF NUM_ROBOTS <> lastnum THEN
    IF NUM_ROBOTS > 1 THEN
        135 TO ropt
        90 TO cloakd
        4 TO accstrength
        27 TO cloakt
    ELSE
        120 TO ropt
        130 TO cloakd
        6 TO accstrength
        18 TO cloakt
    END

        NUM_ROBOTS TO lastnum
        0 TO havetrack
        clock - 500 TO lastnear
    END
    clock - lastnear TO isrtmp
    IF isrtmp < nearw THEN clock + 1 TO cloakuntil
    IF clock <= cloakuntil THEN
        1 TO CLOAK
        spdc TO SPEED
    ELSE
        0 TO CLOAK
        spd TO SPEED
    END
    IF FUEL < 17 THEN 0 TO CLOAK
    IF FUEL < 40 THEN 9 TO SPEED
    dh TO DIRECTION
ENDINT
