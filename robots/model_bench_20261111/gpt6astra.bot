; Generated by GPT 6 Astra on Ultra, 2026-11-11
; Prompt:
; Refer to https://radar-to-shot.github.io/radar-to-shot/
; 
; Build the best possible robot script; ensure it defeats all the five sample
; robots in any combination. Output the script here for comparison against 
; robots developed by other agents.

; Meridian
; Predictive tracking, central patrol, reactive cloak, fuel reserve.
; Six hardware points. Angles are clockwise from north.
CPU_SPEED 2
FIRE_RATE 1
ENGINE_SIZE 1
RADAR_RANGE 0
FUEL_CAPACITY 0
CLOAKING 1
ARMOR 1

allocate tick
allocate bearing
allocate range
allocate halfcone
allocate tries
allocate obsx
allocate obsy
allocate obst
allocate lastx
allocate lasty
allocate lasttime
allocate tx
allocate ty
allocate now
allocate age
allocate vx
allocate vy
allocate flight
allocate fx
allocate fy
allocate locked
allocate olddamage
allocate hideuntil

clockwork to time_int_xfer
1 to time_int_mask
29 to speed
90 to direction

; Sweep until a target is found.
search
    bearing + 4 to bearing to radar
    radar to range
    x to obsx
    y to obsy
    tick to obst
    if range < 1 then goto search
    310 / range + 1 to halfcone
    bearing + halfcone to bearing
    0 to locked

; Refine the right edge of the radar cone.
track
    bearing to radar
    radar to range
    x to obsx
    y to obsy
    tick to obst
    if range < 1 then goto lost
    310 / range + 1 to halfcone
    0 to tries
    bearing + halfcone to aim
backedge
    aim to radar
    if radar > 0 then goto edge
    aim + 359 to aim
    tries + 1 to tries
    if tries < 9 then goto backedge
    goto lost
edge
    aim to radar
    if radar < 1 then goto center
    radar to range
    x to obsx
    y to obsy
    tick to obst
    aim + 1 to aim
    tries + 1 to tries
    if tries < 18 then goto edge

; Estimate absolute target position and velocity.
center
    aim + 359 - halfcone mod 360 to bearing
    bearing to angle_conv
    range to dist_conv
    x_conv + obsx to tx
    y_conv + obsy to ty
    obst to now
    now - lasttime to age
    0 to vx to vy
    if locked = 1 then
        if age > 1 then
            tx - lastx * 10 / age to vx
            ty - lasty * 10 / age to vy
            if vx > 40 then 0 to vx
            if vx < -40 then 0 to vx
            if vy > 40 then 0 to vy
            if vy < -40 then 0 to vy
        end
    end
    tx to lastx
    ty to lasty
    now to lasttime
    1 to locked
    range / 18 + 1 to flight
    vx * flight / 10 + tx to fx
    vy * flight / 10 + ty to fy
    if fx < 6 then 6 to fx
    if fx > 375 then 375 to fx
    if fy < 6 then 6 to fy
    if fy > 307 then 307 to fy
    fx - x to x_conv
    fy - y to y_conv
    angle_conv to aim
    if dist_conv > 24 then dist_conv to shot
    now + 4 to now
waiting
    if tick < now then goto waiting
    tx - x to x_conv
    ty - y to y_conv
    angle_conv to bearing
    goto track

; Reacquire nearby, then briefly extrapolate through cloaking.
lost
    bearing + 5 to radar
    if radar > 0 then
        bearing + 5 to bearing
        goto track
    end
    bearing + 355 to radar
    if radar > 0 then
        bearing + 355 to bearing
        goto track
    end
    bearing + 12 to radar
    if radar > 0 then
        bearing + 12 to bearing
        goto track
    end
    bearing + 348 to radar
    if radar > 0 then
        bearing + 348 to bearing
        goto track
    end
    tick - lasttime to age
    if age < 22 then
        if locked = 1 then
            vx * age / 10 + lastx to tx
            vy * age / 10 + lasty to ty
            tx - x to x_conv
            ty - y to y_conv
            angle_conv to bearing
            dist_conv / 18 + age + 1 to flight
            vx * flight / 10 + lastx to fx
            vy * flight / 10 + lasty to fy
            if fx < 6 then 6 to fx
            if fx > 375 then 375 to fx
            if fy < 6 then 6 to fy
            if fy > 307 then 307 to fy
            fx - x to x_conv
            fy - y to y_conv
            angle_conv to aim
            if dist_conv > 24 then dist_conv to shot
            tick + 2 to now
            goto waiting
        end
    end
    0 to locked
    goto search

; One interrupt per physics tick controls movement and cloaking.
clockwork
    tick + 1 to tick
    if damage > olddamage then
        tick + 5 to hideuntil
        damage to olddamage
    end
    if tick < hideuntil then
        1 to cloak
    else
        0 to cloak
    end
    if fuel < 100 then
        0 to cloak
        9 to speed
    else
        29 to speed
    end
    if direction = 90 then
        if x > 241 then 180 to direction
    end
    if direction = 180 then
        if y > 233 then 270 to direction
    end
    if direction = 270 then
        if x < 140 then 0 to direction
    end
    if direction = 0 then
        if y < 80 then 90 to direction
    end
endint