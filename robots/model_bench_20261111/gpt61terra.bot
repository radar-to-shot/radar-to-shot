; Generated by GPT 6.1 Terra on Ultra, 2026-11-11
; Prompt:
; Refer to https://radar-to-shot.github.io/radar-to-shot/
; 
; Build the best possible robot script; ensure it defeats all the five sample
; robots in any combination. Output the script here for comparison against 
; robots developed by other agents.

CPU_SPEED 2
FIRE_RATE 2
CLOAKING 1
FUEL_CAPACITY 1

ALLOCATE savedaim
ALLOCATE lastdamage

clock TO TIME_INT_XFER
1 TO TIME_INT_MASK
AIM - 4 TO AIM
IF X < 180 THEN
    IF Y < 150 THEN
        135 TO DIRECTION
    ELSE
        45 TO DIRECTION
    END
ELSE
    IF Y < 150 THEN
        225 TO DIRECTION
    ELSE
        315 TO DIRECTION
    END
END
19 TO SPEED

hunt
REPEAT
    IF SPEED = 0 THEN
        GOSUB hide
        DIRECTION + 120 TO DIRECTION
        19 TO SPEED
    END
    IF X < 20 THEN 90 TO DIRECTION
    IF Y < 20 THEN 180 TO DIRECTION
    IF X > 360 THEN 270 TO DIRECTION
    IF Y > 290 THEN 0 TO DIRECTION
    IF DAMAGE <> lastdamage THEN GOSUB hide
    AIM + 3 TO AIM
    AIM TO RADAR
UNTIL RADAR > 0

IF SHOT > 0 THEN
    AIM - 9 TO AIM
ELSE
    AIM TO savedaim
    300 / RADAR + AIM - 1 TO AIM
    RADAR / 10 + RADAR TO SHOT
    AIM TO DIRECTION
    IF RADAR < 80 THEN GOSUB hide
    IF RADAR < 110 THEN AIM - 10 TO DIRECTION
    IF RADAR < 85 THEN AIM - 30 TO DIRECTION
    IF RADAR < 45 THEN
        AIM - 120 TO DIRECTION
    ELSE
        IF RADAR < 85 THEN AIM - 40 TO DIRECTION
    END
    savedaim - 4 TO AIM
END
GOTO hunt

hide
DAMAGE TO lastdamage
IF DAMAGE > 75 THEN
    FUEL / 50 TO CLOAK
    IF DAMAGE > 90 THEN CLOAK + 10 TO CLOAK
ELSE
    IF FUEL < 150 THEN
        2 TO CLOAK
        IF DAMAGE > 95 THEN 5 TO CLOAK
    ELSE
        IF FUEL > 1500 THEN
            12 TO CLOAK
        ELSE
            IF FUEL > 750 THEN
                10 TO CLOAK
            ELSE
                5 TO CLOAK
            END
        END
    END
END
RETURN

clock
IF CLOAK > 0 THEN CLOAK - 1 TO CLOAK
ENDINT