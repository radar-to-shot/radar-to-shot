; Radar Hawk - cloaked tracking sniper with corner patrol (Robot Warriors)
CPU_SPEED 2
RADAR_RANGE 0
FIRE_RATE 2
CLOAKING 1
FUEL_CAPACITY 1
ENGINE_SIZE 0
ARMOR 0
DEFINE ropt 55
DEFINE cloakd 65
DEFINE spdhi 19
DEFINE spdlo 19
DEFINE spdc 9
DEFINE cloakt 18
DEFINE lostd 0
DEFINE neard 100
DEFINE nearw 0
DEFINE bmin 5
DEFINE bmax 10
DEFINE patw 150

ALLOCATE clock
ALLOCATE dh
ALLOCATE sg
ALLOCATE turncnt
ALLOCATE spd
ALLOCATE cloakuntil
ALLOCATE lastdmg
ALLOCATE havetrack
ALLOCATE fixes
ALLOCATE misses
ALLOCATE tclock
ALLOCATE tx
ALLOCATE ty
ALLOCATE vx
ALLOCATE vy
ALLOCATE ax
ALLOCATE ay
ALLOCATE at
ALLOCATE lx
ALLOCATE ly
ALLOCATE lt
ALLOCATE sa
ALLOCATE sw
ALLOCATE r
ALLOCATE rr
ALLOCATE q
ALLOCATE c
ALLOCATE h
ALLOCATE lo
ALLOCATE hi
ALLOCATE mid
ALLOCATE mx
ALLOCATE my
ALLOCATE fclock
ALLOCATE zx
ALLOCATE zy
ALLOCATE dt
ALLOCATE dta
ALLOCATE px
ALLOCATE py
ALLOCATE pb
ALLOCATE pd
ALLOCATE tt
ALLOCATE kk
ALLOCATE dq
ALLOCATE ad
ALLOCATE ldx
ALLOCATE ldy
ALLOCATE ux
ALLOCATE uy
ALLOCATE fx
ALLOCATE fy
ALLOCATE ar
ALLOCATE tmp
ALLOCATE nshots
ALLOCATE lastnum
ALLOCATE lastnear
ALLOCATE nfix
ALLOCATE wpi
ALLOCATE wx
ALLOCATE wy
ALLOCATE lasttrack
ALLOCATE wpt
ALLOCATE stm
ALLOCATE patinit

    tick_isr TO TIME_INT_XFER
    NUM_ROBOTS TO lastnum
    1 TO sg
    19 TO spd
    spd TO SPEED
    1 TO TIME_INT_MASK
main
    IF havetrack = 0 THEN
        GOSUB search
    ELSE
        GOSUB track
    END
GOTO main

search
    GOSUB seekcenter
    sa + 5 MOD 360 TO sa
    sa TO RADAR
    RADAR TO r
    IF r > 0 THEN GOSUB newtrack
RETURN

seekcenter
    clock - lasttrack TO stm
    190 TO wx
    156 TO wy
    IF stm >= patw THEN
        IF patinit = 0 THEN GOSUB pickwp
        GOSUB waypoint
    END
    wx - X TO X_CONV
    wy - Y TO Y_CONV
    ANGLE_CONV TO dh
    19 TO spd
    IF DIST_CONV < 40 THEN 9 TO spd
    IF stm >= patw THEN
        IF DIST_CONV < 35 THEN GOSUB nextwp
        IF clock - wpt > 160 THEN GOSUB nextwp
    END
RETURN

pickwp
    IF X < 190 THEN
        IF Y < 156 THEN
            0 TO wpi
        ELSE
            3 TO wpi
        END
    ELSE
        IF Y < 156 THEN
            1 TO wpi
        ELSE
            2 TO wpi
        END
    END
    clock TO wpt
    1 TO patinit
RETURN

waypoint
    IF wpi = 0 THEN
        65 TO wx
        65 TO wy
    END
    IF wpi = 1 THEN
        316 TO wx
        65 TO wy
    END
    IF wpi = 2 THEN
        316 TO wx
        248 TO wy
    END
    IF wpi = 3 THEN
        65 TO wx
        248 TO wy
    END
RETURN

nextwp
    wpi + 1 MOD 4 TO wpi
    clock TO wpt
RETURN

newtrack
    GOSUB waittick
    sa TO RADAR
    RADAR TO r
    IF r > 0 THEN
        GOSUB refine
        GOSUB fixpos
        0 TO fixes
        GOSUB update
        0 TO misses
        c TO pb
        r TO pd
        1 TO havetrack
    END
RETURN

waittick
    clock TO kk
    WHILE clock = kk DO
        kk TO tmp
    END
    X TO mx
    Y TO my
    clock TO fclock
RETURN

refine
    310 / r + 1 TO h
    IF h > 32 THEN 32 TO h
    0 - h - h + sa - 1 TO lo
    sa TO hi
    WHILE hi - lo > 1 DO
        hi + lo / 2 TO mid
        mid TO RADAR
        RADAR TO q
        IF q > 0 THEN
            mid TO hi
        ELSE
            mid TO lo
        END
    END
    hi + h + 360 MOD 360 TO c
RETURN

fixpos
    c TO ANGLE_CONV
    r TO DIST_CONV
    X_CONV + mx * 16 TO zx
    Y_CONV + my * 16 TO zy
    nfix + 1 TO nfix
RETURN

update
    IF fixes = 0 THEN
        zx TO ax
        zy TO ay
        fclock TO at
        0 TO vx
        0 TO vy
    ELSE
        fclock - at TO dta
        IF dta >= bmin THEN
            zx - ax / dta TO vx
            zy - ay / dta TO vy
            IF vx > 70 THEN 70 TO vx
            IF vx < -70 THEN -70 TO vx
            IF vy > 70 THEN 70 TO vy
            IF vy < -70 THEN -70 TO vy
        END
        IF dta >= bmax THEN
            lx TO ax
            ly TO ay
            lt TO at
        END
    END
    zx TO lx
    zy TO ly
    fclock TO lt
    zx TO tx
    zy TO ty
    fclock TO tclock
    IF fixes < 30 THEN fixes + 1 TO fixes
RETURN

track
    clock TO lasttrack
    0 TO patinit
    clock - tclock TO dt
    IF dt > 45 THEN
        0 TO havetrack
        RETURN
    END
    IF dt < 3 THEN
        GOSUB fire_ctl
        GOSUB bgscan
        RETURN
    END
    dt + 1 TO tt
    vx * tt + tx TO px
    vy * tt + ty TO py
    GOSUB clampp
    px / 16 - X TO ldx
    py / 16 - Y TO ldy
    ldx TO X_CONV
    ldy TO Y_CONV
    ANGLE_CONV TO pb
    DIST_CONV TO pd
    GOSUB waittick
    GOSUB seek
    IF r > 0 THEN
        GOSUB refine
        GOSUB fixpos
        GOSUB update
        0 TO misses
        IF r < cloakd THEN clock + cloakt TO cloakuntil
        IF r < neard THEN clock TO lastnear
    ELSE
        misses + 1 TO misses
        IF fixes > 3 THEN
            IF pd < lostd THEN clock + cloakt TO cloakuntil
        END
        GOSUB wide
        IF r > 0 THEN
            GOSUB refine
            GOSUB fixpos
            GOSUB update
            0 TO misses
            IF r < cloakd THEN clock + cloakt TO cloakuntil
            IF r < neard THEN clock TO lastnear
        IF r < neard THEN clock TO lastnear
        END
    END
    GOSUB fire_ctl
    IF misses > 2 THEN GOSUB bgscan
    GOSUB steer
RETURN

seek
    pb TO sa
    sa TO RADAR
    RADAR TO r
    GOSUB gate
    IF r > 0 THEN RETURN
    4 TO kk
    WHILE kk < 13 DO
        pb + kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        pb + 360 - kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        kk + 4 TO kk
    END
RETURN

wide
    IF misses < 2 THEN
        -1 TO r
        RETURN
    END
    16 TO kk
    WHILE kk < 49 DO
        pb + kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        pb + 360 - kk MOD 360 TO sa
        sa TO RADAR
        RADAR TO r
        GOSUB gate
        IF r > 0 THEN RETURN
        kk + 6 TO kk
    END
RETURN

gate
    IF r > 0 THEN
        r - pd TO dq
        IF dq < 0 THEN 0 - dq TO dq
        IF dq > 50 THEN -1 TO r
    END
RETURN

clampp
    IF px < 80 THEN 80 TO px
    IF px > 6016 THEN 6016 TO px
    IF py < 80 THEN 80 TO py
    IF py > 4928 THEN 4928 TO py
RETURN

cloakctl
    IF pd < cloakd THEN
        IF misses < 4 THEN clock + 20 TO cloakuntil
    END
RETURN

steer
    IF pd < 1 THEN 1 TO pd
    ldx * 64 / pd TO ux
    ldy * 64 / pd TO uy
    pd - ropt TO ar
    IF ar > 64 THEN 64 TO ar
    IF ar < -64 THEN -64 TO ar
    spdhi TO spd
    IF ar < 30 THEN
        IF ar > -30 THEN spdlo TO spd
    END
    IF FUEL < 300 THEN
        IF spd > 19 THEN 19 TO spd
    END
    ux * ar / 64 TO fx
    uy * ar / 64 TO fy
    0 - uy * sg * 40 / 64 + fx TO fx
    ux * sg * 40 / 64 + fy TO fy
    IF X < 70 THEN 70 - X * 2 + fx TO fx
    IF X > 311 THEN
        X - 311 * 2 TO tmp
        fx - tmp TO fx
    END
    IF Y < 70 THEN 70 - Y * 2 + fy TO fy
    IF Y > 243 THEN
        Y - 243 * 2 TO tmp
        fy - tmp TO fy
    END
    fx TO X_CONV
    fy TO Y_CONV
    ANGLE_CONV TO dh
RETURN

bgscan
    0 TO kk
    WHILE kk < 3 DO
        sw + 5 MOD 360 TO sw
        sw TO RADAR
        RADAR TO rr
        IF rr > 0 THEN GOSUB contact
        kk + 1 TO kk
    END
RETURN

contact
    IF rr < neard THEN clock TO lastnear
    IF misses > 2 THEN
        sw TO sa
        rr TO r
        GOSUB newtrack
        RETURN
    END
    sw - pb + 540 MOD 360 - 180 TO ad
    IF ad < 0 THEN 0 - ad TO ad
    IF ad < 15 THEN RETURN
    IF rr + 25 < pd THEN
        sw TO sa
        rr TO r
        GOSUB newtrack
    END
RETURN

fire_ctl
    IF SHOT > 0 THEN RETURN
    IF fixes < 3 THEN RETURN
    IF misses > 11 THEN RETURN
    clock - tclock TO dt
    pd / 18 + 1 + dt TO tt
    vx * tt + tx TO px
    vy * tt + ty TO py
    GOSUB clampp
    px / 16 - X TO X_CONV
    py / 16 - Y TO Y_CONV
    DIST_CONV / 18 + 1 + dt TO tt
    vx * tt + tx TO px
    vy * tt + ty TO py
    GOSUB clampp
    px / 16 - X TO X_CONV
    py / 16 - Y TO Y_CONV
    IF DIST_CONV < 22 THEN RETURN
    ANGLE_CONV TO AIM
    DIST_CONV TO SHOT
    nshots + 1 TO nshots
RETURN

tick_isr
    clock + 1 TO clock
    turncnt - 1 TO turncnt
    IF turncnt <= 0 THEN
        0 - sg TO sg
        20 TO RANDOM
        RANDOM + 10 TO turncnt
    END
    IF DAMAGE <> lastdmg THEN
        DAMAGE TO lastdmg
        clock + cloakt TO cloakuntil
    END
    IF NUM_ROBOTS <> lastnum THEN
        NUM_ROBOTS TO lastnum
        0 TO havetrack
        clock - 500 TO lastnear
    END
    clock - lastnear TO tmp
    IF tmp < nearw THEN clock + 1 TO cloakuntil
    IF clock <= cloakuntil THEN
        1 TO CLOAK
        spdc TO SPEED
    ELSE
        0 TO CLOAK
        spd TO SPEED
    END
    IF FUEL < 17 THEN 0 TO CLOAK
    IF FUEL < 40 THEN 9 TO SPEED
    dh TO DIRECTION
ENDINT