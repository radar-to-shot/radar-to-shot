        END
        1 TO rgt
        X + sumx TO sumx
        Y + sumy TO sumy
        rr + sumd TO sumd
        cnt + 1 TO cnt
    END
    bear + 2 + 360 MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        IF found = 0 THEN
            2 TO lft
            1 TO found
        END
        2 TO rgt
        X + sumx TO sumx
        Y + sumy TO sumy
        rr + sumd TO sumd
        cnt + 1 TO cnt
    END
    bear + 3 + 360 MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        IF found = 0 THEN
            3 TO lft
            1 TO found
        END
        3 TO rgt
        X + sumx TO sumx
        Y + sumy TO sumy
        rr + sumd TO sumd
        cnt + 1 TO cnt
    END
    bear + 4 + 360 MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        IF found = 0 THEN
            4 TO lft
            1 TO found
        END
        4 TO rgt
        X + sumx TO sumx
        Y + sumy TO sumy
        rr + sumd TO sumd
        cnt + 1 TO cnt
    END
    bear + 5 + 360 MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        IF found = 0 THEN
            5 TO lft
            1 TO found
        END
        5 TO rgt
        X + sumx TO sumx
        Y + sumy TO sumy
        rr + sumd TO sumd
        cnt + 1 TO cnt
    END
    IF found = 0 THEN
        IF clock - tt > LOSETIME THEN 0 TO locked
        RETURN
    END
    lft + rgt / 2 TO offs
    bear + offs + 360 MOD 360 TO fa
    fa TO ANGLE_CONV
    sumd / cnt TO cdist
    cdist TO DIST_CONV
    sumx / cnt TO fxa
    sumy / cnt TO fya
    X_CONV + fxa TO mx
    Y_CONV + fya TO my
    gosub update
    tx - ox TO dxx
    ty - oy TO dyy
    dxx TO X_CONV
    dyy TO Y_CONV
    DIST_CONV TO dd
    ANGLE_CONV TO bb
    ORBITR - dd + 90 TO ph
    IF ph < 30 THEN 30 TO ph
    IF ph > 150 THEN 150 TO ph
    ph * osgn + bb + 360 MOD 360 TO fh
    IF dd < CLOAKNEAR THEN 1 TO CLOAK
    IF dd > CLOAKFAR THEN 0 TO CLOAK
    IF cdist < FLEED THEN gosub fleefrom
RETURN

update
    clock - hT TO hdt
    IF hdt >= HB THEN
        mx - hx TO ex
        ex * 10 / hdt TO ex
        my - hy TO ey
        ey * 10 / hdt TO ey
        ex TO vx
        ey TO vy
        mx TO hx
        my TO hy
        clock TO hT
    END
    mx TO tx
    my TO ty
    clock TO tt
RETURN

aimfire
    clock - tt TO dt
    vx * dt / 10 + tx TO px
    vy * dt / 10 + ty TO py
    X TO ox
    Y TO oy
    px - ox TO dxx
    py - oy TO dyy
    dxx TO X_CONV
    dyy TO Y_CONV
    IF DIST_CONV < AVOIDD THEN
        vx * dxx TO dotv
        vy * dyy + dotv TO dotv
        IF dotv < 0 THEN
            0 - dxx TO X_CONV
            0 - dyy TO Y_CONV
            60 TO RANDOM
            ANGLE_CONV + RANDOM - 30 TO fleeh
            1 TO orbit
            clock + FLEET TO fleetime
        END
    END
    IF clock - tt > FRESH THEN RETURN
    DIST_CONV / SHOT_SPEED + 1 TO fl
    vx * fl / 10 + px TO qx
    vy * fl / 10 + py TO qy
    qx - ox TO dxx
    qy - oy TO dyy
    dxx TO X_CONV
    dyy TO Y_CONV
    DIST_CONV / SHOT_SPEED + 1 TO fl
    vx * fl / 10 + px TO qx
    vy * fl / 10 + py TO qy
    qx - ox TO dxx
    qy - oy TO dyy
    dxx TO X_CONV
    dyy TO Y_CONV
    IF DIST_CONV > MINFIRE THEN
        IF DIST_CONV < MAXFIRE THEN
            ANGLE_CONV TO AIM
            DIST_CONV TO SHOT
        END
    END
RETURN

fleefrom
    fa + 180 TO fleeh
    60 TO RANDOM
    RANDOM - 30 + fleeh TO fleeh
    1 TO orbit
    clock + FLEET TO fleetime
RETURN

orbitcalc
    X TO ox
    Y TO oy
    ox - 190 TO X_CONV
    oy - 156 TO Y_CONV
    ANGLE_CONV TO ocang
    DIST_CONV TO ocd
    ocd - ORR + 90 TO phi
    IF phi < 30 THEN 30 TO phi
    IF phi > 150 THEN 150 TO phi
    phi * osgn + ocang + 360 MOD 360 TO wdir
RETURN

steer
    IF x < MARGIN THEN
        IF y < MARGIN THEN
            40 TO RANDOM
            RANDOM - 20 + 135 TO DIRECTION
        ELSE
            IF y > YHI THEN
                40 TO RANDOM
                RANDOM - 20 + 45 TO DIRECTION
            ELSE
                40 TO RANDOM
                RANDOM - 20 + 90 TO DIRECTION
            END
        END
    ELSE
        IF x > XHI THEN
            IF y < MARGIN THEN
                40 TO RANDOM
                RANDOM - 20 + 225 TO DIRECTION
            ELSE
                IF y > YHI THEN
                    40 TO RANDOM
                    RANDOM - 20 + 315 TO DIRECTION
                ELSE
                    40 TO RANDOM
                    RANDOM - 20 + 270 TO DIRECTION
                END
            END
        ELSE
            IF y < MARGIN THEN
                40 TO RANDOM
                RANDOM + 160 TO DIRECTION
            ELSE
                IF y > YHI THEN
                    40 TO RANDOM
                    RANDOM - 20 TO DIRECTION
                ELSE
                    IF orbit = 1 THEN
                        fleeh TO DIRECTION
                    ELSE
                        wdir TO DIRECTION
                    END
                END
            END
        END
    END
RETURN

tick_int
    clock + 1 TO clock
    IF x = lastx THEN
        IF y = lasty THEN
            stuckc + 1 TO stuckc
        ELSE
            0 TO stuckc
        END
    ELSE
        0 TO stuckc
    END
    x TO lastx
    y TO lasty
    IF stuckc > STUCKT THEN
        0 TO stuckc
        360 TO RANDOM
        RANDOM TO fleeh
        1 TO orbit
        clock + ESCT TO fleetime
    END
    wc + 1 TO wc
    IF clock > fleetime THEN 0 TO orbit
    SPD TO SPEED
    IF FUEL < 400 THEN 19 TO SPEED
    IF FUEL < 120 THEN 9 TO SPEED
    gosub steer
ENDINT