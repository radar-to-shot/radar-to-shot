0 TO sa
0 TO vx
0 TO vy
0 TO orbit
0 TO wc
0 TO wdir
1 TO osgn
0 - GATE TO ngate
SPD TO SPEED
tick_int TO TIME_INT_XFER
1 TO TIME_INT_MASK

main
    oc + 1 TO oc
    IF oc > 3 THEN
        0 TO oc
        gosub orbitcalc
    END
    IF locked = 0 THEN gosub sweep
    IF locked = 1 THEN gosub refix
    IF locked = 1 THEN gosub aimfire
GOTO main

sweep
    0 TO orbit
    0 TO CLOAK
    sa + STEP MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        sa TO fa
        IF rr < FLEED THEN gosub fleefrom
        gosub acquire
        RETURN
    END
    sa + STEP MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        sa TO fa
        IF rr < FLEED THEN gosub fleefrom
        gosub acquire
        RETURN
    END
    sa + STEP MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        sa TO fa
        IF rr < FLEED THEN gosub fleefrom
        gosub acquire
        RETURN
    END
RETURN

acquire
    X TO ox
    Y TO oy
    sa TO ANGLE_CONV
    rr TO DIST_CONV
    X_CONV + ox TO tx
    Y_CONV + oy TO ty
    0 TO vx
    0 TO vy
    clock TO tt
    tx TO hx
    ty TO hy
    clock TO hT
    2 TO RANDOM
    1 TO osgn
    1 TO locked
RETURN

refix
    X TO ox
