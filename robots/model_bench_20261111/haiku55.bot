        END
        -1 TO rgt
        X + sumx TO sumx
        Y + sumy TO sumy
        rr + sumd TO sumd
        cnt + 1 TO cnt
    END
    bear + 0 + 360 MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        IF found = 0 THEN
            0 TO lft
            1 TO found
        END
        0 TO rgt
        X + sumx TO sumx
        Y + sumy TO sumy
        rr + sumd TO sumd
        cnt + 1 TO cnt
    END
    bear + 1 + 360 MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        IF found = 0 THEN
            1 TO lft
