    bear - 5 + 360 MOD 360 TO sa
    sa TO RADAR
    RADAR TO rr
    IF rr > 0 THEN
        IF found = 0 THEN
            -5 TO lft
            1 TO found
        END
        -5 TO rgt
        X + sumx TO sumx
