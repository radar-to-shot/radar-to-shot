; 
; Build the best possible robot script; ensure it defeats all the five sample
; robots in any combination. Output the script here for comparison against 
; robots developed by other agents.

; Robot Name:  Serpent
;
;   Radar-bisection tracker with lead (linear + constant-turn) fire control.
;   Duels:  serpentine / tight-circle evasion at full speed (hard to lead).
;   Melee:  orbits its nearest target, sweeps for closer robots while the
;           gun reloads, and switches to wide evasive arcs once a cloaking
;           pursuer (Seeker-type) shows up.  Cloaked targets are followed
;           with a pursuit-model "ghost" until they reappear.
;
;   Hardware (6 points):  CPU_SPEED 2, FIRE_RATE 3, ENGINE_SIZE 1.

CPU_SPEED 2
FIRE_RATE 3
ENGINE_SIZE 1

ALLOCATE t
ALLOCATE tl
ALLOCATE st
ALLOCATE a
ALLOCATE fa
ALLOCATE da
ALLOCATE dtf
ALLOCATE ft
ALLOCATE q
ALLOCATE m
ALLOCATE w
ALLOCATE r
ALLOCATE rp
ALLOCATE px
ALLOCATE py
ALLOCATE pt
ALLOCATE ox
ALLOCATE oy
ALLOCATE ot
ALLOCATE nx
ALLOCATE ny
ALLOCATE nt
ALLOCATE qx
ALLOCATE qy
ALLOCATE qt
ALLOCATE vdt
ALLOCATE ld
ALLOCATE d0
ALLOCATE d1
ALLOCATE lo
ALLOCATE hi
ALLOCATE sa
ALLOCATE sc
ALLOCATE fresh
ALLOCATE side
ALLOCATE dir
ALLOCATE oang
ALLOCATE rlo
ALLOCATE rhi
ALLOCATE hd
ALLOCATE hu
ALLOCATE dl
ALLOCATE k
ALLOCATE an
ALLOCATE dd
ALLOCATE sv
ALLOCATE tg
ALLOCATE bg
ALLOCATE gx
ALLOCATE gy
ALLOCATE g0
ALLOCATE gs
ALLOCATE gl
ALLOCATE gm
ALLOCATE ga
ALLOCATE gr
ALLOCATE gu
ALLOCATE gn
ALLOCATE gk
ALLOCATE ph
ALLOCATE nm
ALLOCATE sw
ALLOCATE sk0
ALLOCATE c1
ALLOCATE mel
ALLOCATE em2
ALLOCATE es
ALLOCATE a1
ALLOCATE a2
ALLOCATE s2
ALLOCATE dw
ALLOCATE wl
ALLOCATE cm
ALLOCATE tx
ALLOCATE ty

    tick TO TIME_INT_XFER
    1 TO TIME_INT_MASK
    1 TO side
    1 TO dtf
    29 TO sv
    1 TO es
    IF NUM_ROBOTS > 1 THEN 1 TO mel
    s_search TO st
    60 TO rlo
    85 TO rhi

; ---- one state handler per tick, started right after the clock interrupt ----
main
    t TO tl
mwait
    IF t = tl THEN GOTO mwait
    GOTO st

; ---- search: 9-degree sweep, patrol the arena centre every third tick ----
s_search
    sc + 1 TO sc
    IF sc > 2 THEN
        0 TO sc
        190 - X TO X_CONV
        156 - Y TO Y_CONV
        ANGLE_CONV TO a
        DIST_CONV TO r
        GOSUB move
    ELSE
        sa + 9 TO sa TO RADAR
        IF RADAR > 0 THEN GOTO acq
        sa + 9 TO sa TO RADAR
        IF RADAR > 0 THEN GOTO acq
        sa + 9 TO sa TO RADAR
        IF RADAR > 0 THEN GOTO acq
    END
    sa + 9 TO sa TO RADAR
    IF RADAR > 0 THEN GOTO acq
    sa + 9 TO sa TO RADAR
    IF RADAR > 0 THEN GOTO acq
    sa + 9 TO sa TO RADAR
    IF RADAR > 0 THEN GOTO acq
    sa + 9 TO sa TO RADAR
    IF RADAR > 0 THEN GOTO acq
    GOTO main

acq
    RADAR TO r
    310 / r + 1 TO w
    sa TO a
    0 - w TO lo
    w TO hi
    1 TO fresh
    105 TO rlo
    145 TO rhi
    s_refine TO st
    GOTO main

; ---- refine: binary search for the upper edge of the radar cone ----
s_refine
    IF lo >= hi THEN GOTO rf_done
    lo + hi + 1 / 2 TO m
    a + m + w TO RADAR
    IF RADAR < 0 THEN
        m - 1 TO hi
    ELSE
        RADAR TO r
        m TO lo
    END
    GOTO s_refine
rf_done
    a + lo TO a
    a TO RADAR
    IF RADAR < 0 THEN GOTO lost
    RADAR TO r
    a TO fa
    t TO ft
    0 TO da
    1 TO dtf
    0 TO gk
    GOSUB setpos
    IF fresh > 0 THEN
        0 TO fresh
        px TO ox TO nx TO qx
        py TO oy TO ny TO qy
        pt TO ot TO nt TO qt
    END
    s_track TO st
    GOTO main

lost
    s_search TO st
    60 TO rlo
    85 TO rhi
    IF NUM_ROBOTS < 2 THEN
        IF gk > 0 THEN
            100 TO rlo
            125 TO rhi
        END
    END
    a - 30 TO sa
    GOTO main

; target position (absolute) from bearing a and range r
setpos
    a TO ANGLE_CONV
    r TO DIST_CONV
    X + X_CONV TO px
    Y + Y_CONV TO py
    t TO pt
    310 / r + 1 TO w
    RETURN

; ---- tracking: fire when ready, sweep while reloading (melee), else fix ----
s_track
    IF SHOT = 0 THEN
        IF pt - ot >= 3 THEN
            IF t - pt < 3 THEN
                GOSUB fire
                IF cm > 0 THEN GOTO main
                GOSUB move
                IF NUM_ROBOTS > 1 THEN
                    0 TO sw
                    GOSUB bscan
                    IF sw > 0 THEN GOTO main
                    GOSUB bscan
                END
                GOTO main
            END
        END
    ELSE
        IF SHOT > 5 THEN
            IF NUM_ROBOTS > 1 THEN GOTO aware
        END
    END
    t - ft TO q
    IF q > 2 THEN
        pt - ot TO vdt
        IF vdt < 1 THEN 1 TO vdt
        px - ox * q / vdt + px - X TO X_CONV
        py - oy * q / vdt + py - Y TO Y_CONV
        ANGLE_CONV TO a TO fa
        DIST_CONV TO rp
        1 TO q
        1 TO nm
    ELSE
        q * da / dtf + fa TO a
        r TO rp
        0 TO nm
    END
    a + w TO RADAR
    IF RADAR < 0 THEN GOTO fx_m
    RADAR TO r
    a + w + 2 TO RADAR
    IF RADAR < 0 THEN GOTO fx_p01
    RADAR TO r
    a + w + 3 TO RADAR
    IF RADAR < 0 THEN GOTO fx_p2
    RADAR TO r
    3 TO m
    GOTO fx_done
fx_p2
    2 TO m
    GOTO fx_done
fx_p01
    a + w + 1 TO RADAR
    IF RADAR < 0 THEN GOTO fx_p0
    RADAR TO r
    1 TO m
    GOTO fx_done
fx_p0
    0 TO m
    GOTO fx_done
fx_m
    a + w - 2 TO RADAR
    IF RADAR < 0 THEN GOTO fx_m3
    RADAR TO r
    a + w - 1 TO RADAR
    IF RADAR < 0 THEN GOTO fx_m2
    RADAR TO r
    -1 TO m
    GOTO fx_done
fx_m2
    -2 TO m
    GOTO fx_done
fx_m3
    a + w - 3 TO RADAR
    IF RADAR < 0 THEN GOTO fx_lost
    RADAR TO r
    -3 TO m
fx_done
    a + m TO a
    a - fa TO da
    q TO dtf
    a TO fa
    t TO ft
    GOSUB setpos
    r - rp TO q
    IF q > 20 THEN GOTO fx_jump
    IF q < -20 THEN GOTO fx_jump
    IF pt - nt >= 4 THEN
        ox TO qx
        oy TO qy
        ot TO qt
        nx TO ox
        ny TO oy
        nt TO ot
        px TO nx
        py TO ny
        pt TO nt
        ox - qx TO X_CONV
        oy - qy TO Y_CONV
        ANGLE_CONV TO a1
        GOTO main
    END
    IF nm = 0 THEN GOSUB move
    GOTO main
fx_jump
    px TO ox TO nx TO qx
    py TO oy TO ny TO qy
    pt TO ot TO nt TO qt
    IF nm = 0 THEN GOSUB move
    GOTO main
fx_lost
    s_recover TO st
    IF nm = 0 THEN GOSUB move
    GOTO main

; ---- awareness sweep while the gun reloads (melee only) ----
aware
    0 TO sw
    GOSUB bscan
    IF sw > 0 THEN GOTO main
    GOSUB bscan
    IF sw > 0 THEN GOTO main
    GOSUB bscan
    IF sw > 0 THEN GOTO main
    GOSUB bscan
    IF sw > 0 THEN GOTO main
    GOSUB bscan
    IF sw > 0 THEN GOTO main
    GOSUB move
    GOTO main

; switch to another robot when it is clearly nearer than the current target
bscan
    bg + 11 TO bg TO RADAR
    IF RADAR < 0 THEN RETURN
    IF RADAR + 10 >= r THEN RETURN
    bg - a MOD 360 + 540 MOD 360 - 180 TO dl
    IF dl < 20 THEN
        IF dl > -20 THEN RETURN
    END
    RADAR TO r
    bg TO a
    310 / r + 1 TO w
    0 - w TO lo
    w TO hi
    1 TO fresh
    s_refine TO st
    1 TO sw
    RETURN

; ---- fix failed: look either side, otherwise assume the target cloaked ----
s_recover
    a - w - w - 4 TO RADAR
    IF RADAR > 0 THEN
        IF RADAR - r < 30 THEN
            IF r - RADAR < 30 THEN
                RADAR TO r
                a - w - w - 4 TO a
                GOTO rc_found
            END
        END
    END
    a + w + w + w + 1 TO RADAR
    IF RADAR > 0 THEN
        IF RADAR - r < 30 THEN
            IF r - RADAR < 30 THEN
                RADAR TO r
                a + w + w + w + 1 TO a
                GOTO rc_found
            END
        END
    END
    IF r > 170 THEN GOTO lost
    px TO gx
    py TO gy
    t TO g0 TO gu
    NUM_ROBOTS TO gn
    0 TO gs
    9 TO gl
    1 TO gm
    IF NUM_ROBOTS > 1 THEN
        px + py TO c1
        IF c1 < 170 THEN 0 TO gm
        IF c1 > 524 THEN 0 TO gm
        px - py TO c1
        IF c1 > 211 THEN 0 TO gm
        IF c1 < -143 THEN 0 TO gm
    END
    0 TO ph
    IF gm > 0 THEN t + 300 TO em2
    s_ghost TO st
    GOSUB move
    GOTO main
rc_found
    310 / r + 1 TO w
    0 - w TO lo
    w TO hi
    1 TO fresh
    s_refine TO st
    GOTO main

; ---- ghost: invisible target, assumed to chase me at 20 m/s ----
s_ghost
    IF t - g0 > 50 THEN
        t TO gk
        GOTO lost
    END
    IF NUM_ROBOTS < gn THEN GOTO lost
    IF gm = 0 THEN
        IF t - g0 > 12 THEN GOTO lost
    END
    IF t - g0 > 20 THEN 53 TO gl
    1 - ph TO ph
    IF ph > 0 THEN
        GOSUB gupd
        ga TO a
        gr TO r
        GOSUB gscan
        IF sw > 0 THEN GOTO gh_hit
        GOSUB move
        GOTO main
    END
    GOSUB gscan
    IF sw > 0 THEN GOTO gh_hit
    GOSUB gscan
    IF sw > 0 THEN GOTO gh_hit
    GOSUB gscan
    IF sw > 0 THEN GOTO gh_hit
    GOSUB gscan
    IF sw > 0 THEN GOTO gh_hit
    GOSUB gscan
    IF sw > 0 THEN GOTO gh_hit
    GOTO main
gscan
    0 TO sw
    gs + 1 TO gs
    IF gs > gl THEN 0 TO gs
    gs / 2 * 7 TO q
    IF gs AND 1 = 0 THEN 0 - q TO q
    a + q TO RADAR
    IF RADAR < 0 THEN RETURN
    IF RADAR - r < 60 THEN 1 TO sw
    RETURN
gh_hit
    1 TO fresh
    IF t - g0 < 17 THEN
        IF RADAR < 100 THEN 0 TO fresh
    END
    RADAR TO r
    a + q TO a
    310 / r + 1 TO w
    0 - w TO lo
    w TO hi
    s_refine TO st
    GOTO main

gupd
    X - gx TO X_CONV
    Y - gy TO Y_CONV
    DIST_CONV TO gr
    ANGLE_CONV + 180 TO ga
    IF gm > 0 THEN
        IF gr > 30 THEN
            t - gu * 2 TO DIST_CONV
            gx + X_CONV TO gx
            gy + Y_CONV TO gy
            gr - DIST_CONV TO gr
        END
    END
    t TO gu
    RETURN

; ---- fire control: lead the target, two-pass flight-time solution ----
fire
    pt - ot TO vdt
    IF vdt < 1 THEN 1 TO vdt
    0 TO cm
    ot - qt TO d1
    IF d1 > 2 THEN
        IF d1 < 9 THEN
            IF vdt > 2 THEN
                IF vdt < 9 THEN GOSUB cset
            END
        END
    END
    r / 18 + 1 TO d0
    t - pt + d0 TO ld
    GOSUB pred
    DIST_CONV / 18 + 1 TO m
    IF m <> d0 THEN
        t - pt + m TO ld
        GOSUB pred
    END
    IF DIST_CONV < 17 THEN RETURN
    ANGLE_CONV TO AIM
    DIST_CONV TO SHOT
    RETURN

; use the constant-turn model when the target is clearly turning
cset
    px - ox TO X_CONV
    py - oy TO Y_CONV
    ANGLE_CONV TO a2
    DIST_CONV TO s2
    a2 - a1 + 540 MOD 360 - 180 TO dw
    dw TO c1
    IF c1 < 0 THEN 0 - c1 TO c1
    d1 + vdt * 8 TO dl
    IF c1 * 4 < dl THEN RETURN
    vdt * 12 TO dl
    IF s2 * 10 < dl THEN RETURN
    1 TO cm
    RETURN

pred
    IF cm > 0 THEN GOTO cpred
    px - ox * ld / vdt + px - X TO X_CONV
    py - oy * ld / vdt + py - Y TO Y_CONV
    RETURN
cpred
    d1 + vdt TO dd
    dw * ld * 2 / dd TO wl
    IF wl > 170 THEN 170 TO wl
    IF wl < -170 THEN -170 TO wl
    vdt + ld * dw / dd + a2 TO ANGLE_CONV
    wl * wl / 79 TO c1
    1000 - c1 / 10 TO c1
    s2 * ld / vdt * c1 / 100 TO DIST_CONV
    px + X_CONV - X TO tx
    py + Y_CONV - Y TO ty
    tx TO X_CONV
    ty TO Y_CONV
    RETURN

; ---- movement ----
move
    IF SPEED = 0 THEN
        IF t > 3 THEN GOTO mv_stuck
    END
    IF NUM_ROBOTS < 2 THEN
        IF gk = 0 THEN GOTO evade
    ELSE
        IF em2 > t THEN GOTO evade
    END
    IF t AND 3 = 0 THEN GOSUB spdsel
    1 - tg TO tg
    sv - tg TO SPEED
    IF t < hu THEN
        hd TO dir
        GOSUB wallfix
        IF k > 0 THEN dir TO DIRECTION TO hd
        RETURN
    END
    a TO AIM
    AIM TO an
    90 TO oang
    IF r > rhi THEN 25 TO oang
    IF r < rlo THEN 125 TO oang
    side * oang + an TO AIM
    AIM TO dir TO dd
    GOSUB wallfix
    IF k > 0 THEN
        dir - dd + 540 MOD 360 - 180 TO dl
        IF dl > 60 THEN GOTO mv_flip
        IF dl < -60 THEN GOTO mv_flip
    END
mv_go
    dir - hd + 540 MOD 360 - 180 TO dl
    IF t > 9 THEN
        IF dl > 120 THEN GOTO mv_big
        IF dl < -120 THEN GOTO mv_big
    END
    dir TO DIRECTION TO hd
    RETURN
mv_flip
    0 - side TO side
    side * oang + an TO AIM
    AIM TO dir
    GOSUB wallfix
    GOTO mv_go
mv_big
    hd + 90 - an + 540 MOD 360 - 180 TO dl
    IF dl > 90 THEN GOTO mv_bp
    IF dl < -90 THEN GOTO mv_bp
    hd + 270 TO AIM
    GOTO mv_b2
mv_bp
    hd + 90 TO AIM
mv_b2
    AIM TO dir
    GOSUB wallfix
    dir TO DIRECTION TO hd
    t + 8 TO hu
    RETURN

; serpentine away from / toward the target, otherwise keep turning
evade
    1 - tg TO tg
    39 TO c1
    IF mel > 0 THEN
        IF r > 115 THEN 29 TO c1
    END
    IF FUEL < 500 THEN 29 TO c1
    IF FUEL < 150 THEN 19 TO c1
    IF FUEL < 40 THEN 9 TO c1
    c1 - tg TO SPEED
    a TO AIM
    AIM TO an
    100 TO q
    160 TO dd
    8 TO c1
    IF mel > 0 THEN
        120 TO q
        180 TO dd
        2 TO c1
    END
    IF r < q THEN
        hd - an + 360 MOD 360 - 180 TO dl
        IF dl > 60 THEN -1 TO es
        IF dl < -60 THEN 1 TO es
    ELSE
        IF r > dd THEN
            hd - an + 540 MOD 360 - 180 TO dl
            IF dl > 60 THEN -1 TO es
            IF dl < -60 THEN 1 TO es
        END
    END
    es * c1 + hd TO AIM
    AIM TO dir
    GOSUB wallfix
    IF k > 0 THEN 0 - es TO es
    dir TO DIRECTION TO hd
    RETURN

spdsel
    29 TO sv
    IF r < 108 THEN 39 TO sv
    IF st = s_ghost THEN
        IF gm > 0 THEN 39 TO sv
    END
    IF st = s_search THEN
        29 TO sv
        IF gk > 0 THEN 39 TO sv
    END
    IF FUEL < 120 THEN 19 TO sv
    IF FUEL < 40 THEN 9 TO sv
    RETURN

; after a collision: back off, then try another way if still blocked
mv_stuck
    IF t - sk0 < 9 THEN
        hd + 100 TO AIM
    ELSE
        hd + 180 TO AIM
    END
    t TO sk0
    AIM TO dir
    GOSUB wallfix
    dir TO DIRECTION TO hd
    1 - tg TO tg
    39 - tg TO SPEED
    t + 8 TO hu
    RETURN

; keep dir inside an octagon 50 m from the walls with the corners cut off
wallfix
    0 TO k
    IF Y < 50 THEN
        IF Y < 28 THEN
            IF dir < 100 THEN GOTO wf_td
            IF dir > 260 THEN GOTO wf_td
        ELSE
            IF dir > 270 THEN
                255 TO dir
                1 TO k
            ELSE
                IF dir < 90 THEN
                    105 TO dir
                    1 TO k
                END
            END
        END
    ELSE
        IF Y > 263 THEN
            IF Y > 285 THEN
                IF dir > 80 THEN
                    IF dir < 280 THEN GOTO wf_bd
                END
            ELSE
                IF dir > 90 THEN
                    IF dir < 270 THEN
                        1 TO k
                        IF dir > 180 THEN
                            285 TO dir
                        ELSE
                            75 TO dir
                        END
                    END
                END
            END
        END
    END
wf_x
    IF X < 50 THEN
        IF X < 28 THEN
            IF dir < 10 THEN GOTO wf_ld
            IF dir > 170 THEN GOTO wf_ld
        ELSE
            IF dir > 180 THEN GOTO wf_vl
        END
    ELSE
        IF X > 331 THEN
            IF X > 353 THEN
                IF dir < 190 THEN GOTO wf_rd
                IF dir > 350 THEN GOTO wf_rd
            ELSE
                IF dir < 180 THEN
                    IF dir > 0 THEN GOTO wf_vr
                END
            END
        END
    END
wf_c
    X + Y TO c1
    IF c1 < 150 THEN GOTO wf_tl
    IF c1 > 544 THEN GOTO wf_br
    X - Y TO c1
    IF c1 > 231 THEN GOTO wf_tr
    IF c1 < -163 THEN GOTO wf_bl
    RETURN
wf_tl
    IF dir < 45 THEN
        45 TO dir
        1 TO k
        RETURN
    END
    IF dir > 225 THEN
        1 TO k
        IF dir > 315 THEN
            45 TO dir
        ELSE
            225 TO dir
        END
    END
    RETURN
wf_br
    IF dir > 45 THEN
        IF dir < 225 THEN
            1 TO k
            IF dir < 135 THEN
                45 TO dir
            ELSE
                225 TO dir
            END
        END
    END
    RETURN
wf_tr
    IF dir < 135 THEN
        1 TO k
        IF dir < 45 THEN
            315 TO dir
        ELSE
            135 TO dir
        END
        RETURN
    END
    IF dir > 315 THEN
        315 TO dir
        1 TO k
    END
    RETURN
wf_bl
    IF dir > 135 THEN
        IF dir < 315 THEN
            1 TO k
            IF dir < 225 THEN
                135 TO dir
            ELSE
                315 TO dir
            END
        END
    END
    RETURN
wf_td
    1 TO k
    IF dir < 180 THEN
        135 TO dir
    ELSE
        225 TO dir
    END
    GOTO wf_x
wf_bd
    1 TO k
    IF dir < 180 THEN
        45 TO dir
    ELSE
        315 TO dir
    END
    GOTO wf_x
wf_ld
    1 TO k
    IF dir > 270 THEN
        45 TO dir
        GOTO wf_c
    END
    IF dir < 90 THEN
        45 TO dir
        GOTO wf_c
    END
    135 TO dir
    GOTO wf_c
wf_rd
    1 TO k
    IF dir > 270 THEN
        315 TO dir
        GOTO wf_c
    END
    IF dir < 90 THEN
        315 TO dir
        GOTO wf_c
    END
    225 TO dir
    GOTO wf_c
wf_vl
    1 TO k
    IF Y < 50 THEN
        165 TO dir
        GOTO wf_c
    END
    IF Y > 263 THEN
        15 TO dir
        GOTO wf_c
    END
    IF dir > 270 THEN
        15 TO dir
        GOTO wf_c
    END
    165 TO dir
    GOTO wf_c
wf_vr
    1 TO k
    IF Y < 50 THEN
        195 TO dir
        GOTO wf_c
    END
    IF Y > 263 THEN
        345 TO dir
        GOTO wf_c
    END
    IF dir < 90 THEN
        345 TO dir
        GOTO wf_c
    END
    195 TO dir
    GOTO wf_c

; clock interrupt: one count per tick
tick
    t + 1 TO t
    ENDINT
