; 
; Build the best possible robot script; ensure it defeats all the five sample
; robots in any combination. Output the script here for comparison against 
; robots developed by other agents.

ENGINE_SIZE 1
FIRE_RATE 2
RADAR_RANGE 2
ARMOR 1

ALLOCATE target
ALLOCATE ringang
ALLOCATE tx
ALLOCATE ty
ALLOCATE chase
ALLOCATE chaseang
ALLOCATE clock
ALLOCATE seen
ALLOCATE lastang
ALLOCATE lasttime
ALLOCATE delta

40 TO SPEED
IF X < 190 THEN
    270 TO DIRECTION
    WHILE X > 10 DO
        IF X < 40 THEN 9 TO SPEED
    END
ELSE
    90 TO DIRECTION
    WHILE X < 371 DO
        IF X > 340 THEN 9 TO SPEED
    END
END

IF Y < 156 THEN
    0 TO DIRECTION
    WHILE Y > 10 DO
        IF Y < 40 THEN 9 TO SPEED
    END
ELSE
    180 TO DIRECTION
    WHILE Y < 303 DO
        IF Y > 273 THEN 9 TO SPEED
    END
END

IF X < 190 THEN
    IF Y < 156 THEN
        135 TO DIRECTION
    ELSE
        45 TO DIRECTION
    END
ELSE
    IF Y < 156 THEN
        225 TO DIRECTION
    ELSE
        315 TO DIRECTION
    END
END
0 TO SPEED
0 TO chase
0 TO clock
0 TO seen
0 TO lastang
0 TO lasttime
0 TO delta
Timer TO TIME_INT_XFER
1 TO TIME_INT_MASK

main
    AIM + 3 TO AIM
    AIM TO RADAR
    RADAR TO target
    IF NUM_ROBOTS = 1 THEN
        IF target > 0 THEN
            IF seen = 0 THEN
                1 TO seen
                AIM TO lastang
                clock TO lasttime
            ELSE
                IF clock - lasttime > 20 THEN
                    AIM - lastang TO delta
                    IF delta > 180 THEN delta - 360 TO delta
                    IF delta < -180 THEN delta + 360 TO delta
                    IF delta > 10 THEN GOSUB chasebot
                    IF delta < -10 THEN GOSUB chasebot
                    AIM TO lastang
                    clock TO lasttime
                END
            END
        END
    ELSE
        0 TO seen
    END
    IF SHOT = 0 THEN
        IF target > 25 THEN
            IF target < 180 THEN
                target TO SHOT
            ELSE
                GOSUB fire_area
            END
        ELSE
            GOSUB fire_area
        END
    END
GOTO main

chasebot
    AIM TO chaseang
    25 TO chase
RETURN

fire_area
    360 TO RANDOM
    RANDOM TO ringang
    ringang TO ANGLE_CONV
    25 TO DIST_CONV
    X_CONV + 190 TO tx
    Y_CONV + 156 TO ty
    tx - X TO X_CONV
    ty - Y TO Y_CONV
    ANGLE_CONV TO AIM
    DIST_CONV TO SHOT
RETURN

Timer
    clock + 1 TO clock
    IF chase > 0 THEN
        chaseang TO DIRECTION
        IF FUEL < 300 THEN
            9 TO SPEED
        ELSE
            40 TO SPEED
        END
        chase - 1 TO chase
    ELSE
        0 TO SPEED
    END
ENDINT