; Vector Sentinel
; Predictive fire, collision avoidance, economical escape bursts.
; Six hardware points.

CPU_SPEED 1
FIRE_RATE 0
ENGINE_SIZE 1
RADAR_RANGE 0
FUEL_CAPACITY 2
CLOAKING 0
ARMOR 2

ALLOCATE clock
ALLOCATE ang
ALLOCATE dist
ALLOCATE wid
ALLOCATE leftdist
ALLOCATE rightdist
ALLOCATE tx
ALLOCATE ty
ALLOCATE oldtx
ALLOCATE oldty
ALLOCATE oldtick
ALLOCATE dt
ALLOCATE flight
ALLOCATE dx
ALLOCATE dy
ALLOCATE leadx
ALLOCATE leady
ALLOCATE adjust
ALLOCATE busy
ALLOCATE ahead
ALLOCATE fastuntil
ALLOCATE olddamage

90 TO DIRECTION
29 TO SPEED
0 TO ang
Timer TO TIME_INT_XFER
1 TO TIME_INT_MASK

search
    1 TO busy
    ang TO RADAR
    RADAR TO dist
    0 TO busy
    IF dist > 20 THEN
        310 / dist + 1 TO wid
        ang + wid TO ang
        0 TO oldtick
        GOTO track
    END
    ang + 4 TO ang
    IF ang > 359 THEN ang - 360 TO ang
GOTO search

track
    1 TO busy
    ang TO RADAR
    RADAR TO dist
    0 TO busy
    IF dist < 21 THEN
        ang + 4 TO ang
        GOTO search
    END

    310 / dist + 1 TO wid
    wid / 2 + 1 TO adjust
    1 TO busy
    ang + 360 - wid TO RADAR
    RADAR TO leftdist
    ang + wid TO RADAR
    RADAR TO rightdist
    0 TO busy

    IF leftdist < 0 THEN
        IF rightdist > 0 THEN ang + adjust TO ang
    ELSE
        IF rightdist < 0 THEN ang + 360 - adjust TO ang
    END

    ang + 360 MOD 360 TO ang
    ang TO ANGLE_CONV
    dist TO DIST_CONV
    X_CONV + X TO tx
    Y_CONV + Y TO ty
    clock - oldtick TO dt

    IF oldtick = 0 THEN
        tx TO oldtx
        ty TO oldty
        clock TO oldtick
    END

    IF SHOT = 0 THEN
        dist / 18 + 1 TO flight
        tx - oldtx TO dx
        ty - oldty TO dy

        IF dt < 4 THEN
            0 TO dx TO dy
            1 TO dt
        END

        IF dx > 80 THEN 0 TO dx TO dy
        IF dx < -80 THEN 0 TO dx TO dy
        IF dy > 80 THEN 0 TO dx TO dy
        IF dy < -80 THEN 0 TO dx TO dy

        dx * flight / dt + tx TO leadx
        dy * flight / dt + ty TO leady

        IF leadx < 6 THEN 6 TO leadx
        IF leadx > 375 THEN 375 TO leadx
        IF leady < 6 THEN 6 TO leady
        IF leady > 307 THEN 307 TO leady

        leadx - X TO X_CONV
        leady - Y TO Y_CONV
        ANGLE_CONV TO AIM
        IF DIST_CONV > 20 THEN DIST_CONV TO SHOT
    END

    IF dt > 8 THEN
        tx TO oldtx
        ty TO oldty
        clock TO oldtick
    END
GOTO track

Timer
    clock + 1 TO clock

    IF DIRECTION = 90 THEN
        IF X > 286 THEN 180 TO DIRECTION
    END
    IF DIRECTION = 180 THEN
        IF Y > 218 THEN 270 TO DIRECTION
    END
    IF DIRECTION = 270 THEN
        IF X < 95 THEN 0 TO DIRECTION
    END
    IF DIRECTION = 0 THEN
        IF Y < 95 THEN 90 TO DIRECTION
    END

    IF busy = 0 THEN
        DIRECTION TO RADAR
        RADAR TO ahead
        IF ahead > 0 THEN
            IF ahead < 90 THEN DIRECTION + 90 TO DIRECTION
        END
    END

    IF SPEED = 0 THEN
        DIRECTION + 90 TO DIRECTION
        29 TO SPEED
    END

    IF DAMAGE <> olddamage THEN
        clock + 60 TO fastuntil
        DAMAGE TO olddamage
    END

    IF clock < fastuntil THEN
        39 TO SPEED
    ELSE
        29 TO SPEED
    END

    IF FUEL < 1000 THEN 29 TO SPEED
    IF FUEL < 50 THEN 9 TO SPEED
ENDINT