; Generated by Opus 5.5 on Max, 2026-11-11
; Prompt:
; Refer to https://radar-to-shot.github.io/radar-to-shot/
; 
; Build the best possible robot script; ensure it defeats all the five sample
; robots in any combination. Output the script here for comparison against 
; robots developed by other agents.

; Hunter - radar edge tracker with lead-aiming gun
;
; Hardware (6 points): CPU 2, engine 1, radar 310 m, fuel 3200, fire rate 0, no armor/cloak.
; Interrupt (every tick): pins one exact edge of the radar cone on the tracked robot
;   (bearing exact to the degree), converts the fix to arena x/y, and fires with lead.
; Main loop: alpha-beta tracking filter with an optional constant-turn model (used only when
;   the target's turn rate is consistent), and movement: a fast loop around the arena centre.
;   A tracked robot that moves fast through open ground (not wall-hugging, not axis-aligned,
;   i.e. not one of the samples) switches the loop into an evasive mode: random loop radius
;   and sharper corrections, so leading shooters cannot predict the path.
CPU_SPEED 2
ENGINE_SIZE 1
FIRE_RATE 0
RADAR_RANGE 1
FUEL_CAPACITY 2
ARMOR 0

DEFINE kR 105

; ---- interrupt side ----
ALLOCATE clock
ALLOCATE trk
ALLOCATE tid
ALLOCATE sa
ALLOCATE b
ALLOCATE b16
ALLOCATE db16
ALLOCATE w
ALLOCATE lo
ALLOCATE hi
ALLOCATE r
ALLOCATE d
ALLOCATE n
ALLOCATE ph
ALLOCATE lost
ALLOCATE pb
ALLOCATE pbt
ALLOCATE ra
ALLOCATE nofire
ALLOCATE tt
ALLOCATE t2
ALLOCATE t3
ALLOCATE ax
ALLOCATE ay
ALLOCATE th
ALLOCATE vm
ALLOCATE a1
ALLOCATE mm
ALLOCATE hx0
ALLOCATE hy0
ALLOCATE cgen
; ---- raw fix: interrupt -> main ----
ALLOCATE pend
ALLOCATE rx
ALLOCATE ry
ALLOCATE rt
ALLOCATE rid
; ---- filter: main writes, interrupt reads ----
ALLOCATE fx
ALLOCATE fy
ALLOCATE fvx
ALLOCATE fvy
ALLOCATE ftime
ALLOCATE nfix
ALLOCATE fid
ALLOCATE om16
ALLOCATE sn
ALLOCATE cs
; ---- main side ----
ALLOCATE qt
ALLOCATE zx
ALLOCATE zy
ALLOCATE e
ALLOCATE ga
ALLOCATE gb
ALLOCATE dt
ALLOCATE u1
ALLOCATE u2
ALLOCATE u3
ALLOCATE u4
ALLOCATE u5
ALLOCATE ox
ALLOCATE oy
ALLOCATE ptht
ALLOCATE side
ALLOCATE dd
ALLOCATE k
ALLOCATE spd
ALLOCATE ca
ALLOCATE nextst
ALLOCATE rtgt
ALLOCATE rtlast
ALLOCATE rtnext
ALLOCATE kg
ALLOCATE fastc
ALLOCATE omdev

    1 TO side
    kR TO rtgt
    29 TO SPEED
    256 TO cs
    handler TO TIME_INT_XFER
    1 TO TIME_INT_MASK

; main loop: filter new fixes, steer every 5 ticks (or at once after a collision)
main
    IF pend > 0 THEN GOSUB procfix
    IF SPEED = 0 THEN GOTO mstr
    IF clock < nextst THEN GOTO main
mstr
    clock + 5 TO nextst
    GOSUB steer
    GOTO main

; ======================= interrupt =======================
handler
    clock + 1 TO clock
    IF trk = 0 THEN GOTO search
    b16 + db16 TO b16
    b16 + 8 / 16 TO b
    IF SHOT = 0 THEN GOTO hfire
hscan
    IF lost > 0 THEN GOTO reacq
    0 TO n
    IF ph > 0 THEN GOTO thi
; ---- measure the low edge: hit at lo -> step down to the last hit; miss -> step up ----
    1 TO ph
    b - w TO lo
    lo TO RADAR
    RADAR TO d
    IF d < 0 THEN GOTO tlomiss
    d TO r
tlodn
    lo - 1 TO RADAR
    RADAR TO d
    IF d < 0 THEN GOTO tloex
    d TO r
    lo - 1 TO lo
    n + 1 TO n
    IF n < 3 THEN GOTO tlodn
    lo + w TO b
    GOTO tpart
tlomiss
    lo + 1 TO lo TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO tlohit
    IF lo >= b THEN GOTO tnone
    n + 1 TO n
    IF n < 3 THEN GOTO tlomiss
    GOTO tnone
tlohit
    d TO r
tloex
    lo + w TO b
    GOTO tfix
; ---- measure the high edge ----
thi
    0 TO ph
    b + w TO hi
    hi TO RADAR
    RADAR TO d
    IF d < 0 THEN GOTO thimiss
    d TO r
thiup
    hi + 1 TO RADAR
    RADAR TO d
    IF d < 0 THEN GOTO thiex
    d TO r
    hi + 1 TO hi
    n + 1 TO n
    IF n < 3 THEN GOTO thiup
    hi - w TO b
    GOTO tpart
thimiss
    hi - 1 TO hi TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO thihit
    IF hi <= b THEN GOTO tnone
    n + 1 TO n
    IF n < 3 THEN GOTO thimiss
    GOTO tnone
thihit
    d TO r
thiex
    hi - w TO b
tfix
    IF b > 359 THEN b - 360 TO b
    IF b < 0 THEN b + 360 TO b
    b TO ANGLE_CONV
    r TO DIST_CONV
    X + X_CONV TO rx
    Y + Y_CONV TO ry
    cgen + 1 TO cgen
    clock TO rt
    tid TO rid
    1 TO pend
    IF clock - pbt = 1 THEN
        b - pb TO d
        IF d > 180 THEN d - 360 TO d
        IF d < -180 THEN d + 360 TO d
        d * 16 - db16 / 2 + db16 TO db16
        IF db16 > 96 THEN 96 TO db16
        IF db16 < -96 THEN -96 TO db16
    END
    b TO pb
    clock TO pbt
    b * 16 TO b16
    0 - r / 80 + r TO d
    310 / d + 1 TO w
    IF w > 32 THEN 32 TO w
ENDINT
tpart
    IF b > 359 THEN b - 360 TO b
    IF b < 0 THEN b + 360 TO b
    b * 16 TO b16
ENDINT
tnone
    1 TO lost
ENDINT

; ---- target not seen: look around the predicted bearing ----
reacq
    w + w + 1 TO ra
    b TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO racq
    b - ra TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO racqm
    b + ra TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO racqp
    b - ra - ra TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO racqmm
    b + ra + ra TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO racqpp
    lost + 1 TO lost
    IF lost < 9 THEN ENDINT
    0 TO trk
    b - 30 TO sa
    IF sa < 0 THEN sa + 360 TO sa
ENDINT
racqm
    b - ra TO b
    GOTO racq
racqp
    b + ra TO b
    GOTO racq
racqmm
    b - ra - ra TO b
    GOTO racq
racqpp
    b + ra + ra TO b
racq
    IF b > 359 THEN b - 360 TO b
    IF b < 0 THEN b + 360 TO b
    b * 16 TO b16
    0 TO lost
    d TO r
    310 / d + 1 TO w
    IF w > 32 THEN 32 TO w
ENDINT

; ---- sweep search ----
search
    0 TO n
srch
    sa + 5 TO sa
    IF sa > 359 THEN sa - 360 TO sa
    sa TO RADAR
    RADAR TO d
    IF d > 0 THEN GOTO sfound
    n + 1 TO n
    IF n < 5 THEN GOTO srch
ENDINT
sfound
    sa TO b
    sa TO pb
    0 TO pbt
    0 TO db16
    tid + 1 TO tid
    1 TO trk
    GOTO racq

; ---- gun ----
hfire
    IF nfix < 6 THEN GOTO hscan
    IF clock < nofire THEN GOTO hscan
    IF fid <> tid THEN GOTO hscan
    clock - ftime TO t3
    IF t3 > 6 THEN GOTO hscan
    X TO hx0
    Y TO hy0
    cgen + 1 TO cgen
    IF sn <> 0 THEN
        fvx * 4 TO X_CONV
        fvy * 4 TO Y_CONV
        ANGLE_CONV TO th
        DIST_CONV TO vm
    END
    ; first flight-time guess from range and radial speed
    fx / 16 - hx0 / 4 * fvx TO t2
    fy / 16 - hy0 / 4 * fvy + t2 TO t2
    r / 4 + 1 TO tt
    t2 / tt TO t2
    r / 18 + 1 TO tt
    t2 * tt / 16 + r / 18 + 1 TO tt
    IF tt < 1 THEN 1 TO tt
    GOSUB aimpt
    DIST_CONV / 18 + 1 TO t2
    IF t2 <> tt THEN
        t2 TO tt
        GOSUB aimpt
    END
    IF DIST_CONV < 35 THEN
        clock + 4 TO nofire
        GOTO hfend
    END
    IF DIST_CONV > 400 THEN
        clock + 2 TO nofire
        GOTO hfend
    END
    ANGLE_CONV TO AIM
    DIST_CONV TO SHOT
hfend
    IF X <> hx0 THEN GOTO hfstr
    IF Y <> hy0 THEN GOTO hfstr
ENDINT
hfstr
    clock + 1 TO clock
ENDINT

aimpt
    clock - ftime + tt TO t3
    IF sn = 0 THEN
        fvx * t3 + fx / 16 TO ax
        fvy * t3 + fy / 16 TO ay
    ELSE
        t3 + 1 * om16 / 32 + th TO ANGLE_CONV
        t3 * om16 / 16 TO a1
        IF a1 < 0 THEN 0 - a1 TO a1
        IF a1 > 180 THEN 180 TO a1
        a1 * a1 / 1231 TO a1
        vm * t3 TO mm
        mm / 64 * a1 TO a1
        mm - a1 TO DIST_CONV
        X_CONV / 4 + fx / 16 TO ax
        Y_CONV / 4 + fy / 16 TO ay
    END
    IF ax < 6 THEN 6 TO ax
    IF ax > 375 THEN 375 TO ax
    IF ay < 6 THEN 6 TO ay
    IF ay > 307 THEN 307 TO ay
    ax - hx0 TO X_CONV
    ay - hy0 TO Y_CONV
    RETURN

; ======================= main: tracking filter =======================
procfix
    0 TO pend
pfretry
    rt TO qt
    rx TO zx
    ry TO zy
    IF rt <> qt THEN GOTO pfretry
    IF rid <> fid THEN GOTO finit
    qt - ftime TO dt
    IF dt < 1 THEN RETURN
    IF dt > 20 THEN GOTO finit
    dt TO u3
pfm
    IF sn <> 0 THEN GOSUB rotf
    fx + fvx TO fx
    fy + fvy TO fy
    u3 - 1 TO u3
    IF u3 > 0 THEN GOTO pfm
    qt TO ftime
    IF nfix < 5 THEN GOTO pfsch
    zx * 16 - fx TO e
    e / 2 + fx TO fx
    e / 8 / dt + fvx TO fvx
    zy * 16 - fy TO e
    e / 2 + fy TO fy
    e / 8 / dt + fvy TO fvy
    nfix + 1 TO nfix
    nfix AND 3 TO u1
    IF u1 = 0 THEN GOTO estom
    RETURN
pfsch
    1 TO ga
    1 TO gb
    IF nfix = 2 THEN 2 TO gb
    IF nfix = 3 THEN
        2 TO ga
        3 TO gb
    END
    IF nfix = 4 THEN
        2 TO ga
        5 TO gb
    END
    zx * 16 - fx TO e
    e / ga + fx TO fx
    e / gb / dt + fvx TO fvx
    zy * 16 - fy TO e
    e / ga + fy TO fy
    e / gb / dt + fvy TO fvy
    nfix + 1 TO nfix
    RETURN
finit
    zx * 16 TO fx
    zy * 16 TO fy
    0 TO fvx
    0 TO fvy
    qt TO ftime
    0 TO om16
    0 TO sn
    256 TO cs
    0 TO ptht
    64 TO omdev
    1 TO nfix
    rid TO fid
    RETURN

; rotate the filter velocity by the turn rate (one tick)
rotf
    fvy * sn TO u4
    fvx * cs - u4 / 256 TO u5
    fvx * sn TO u4
    fvy * cs + u4 / 256 TO fvy
    u5 TO fvx
    RETURN

; turn rate from the cross product of filtered velocities 4 fixes apart
estom
    fvx / 2 TO u1
    fvy / 2 TO u2
    IF ptht = 0 THEN GOTO estsv
    qt - ptht TO u3
    IF u3 > 12 THEN GOTO estsv
    ox * u2 TO u4
    oy * u1 TO u5
    u4 - u5 TO u4
    ox * u1 TO u5
    oy * u2 + u5 TO u5
    IF u5 < 64 THEN GOTO estz
    u5 / 64 TO u5
    IF u4 > 2000 THEN 2000 TO u4
    IF u4 < -2000 THEN -2000 TO u4
    u4 * 14 / u5 / u3 TO u4
    IF u4 > 160 THEN 160 TO u4
    IF u4 < -160 THEN -160 TO u4
    u4 - om16 TO u5
    IF u5 < 0 THEN 0 - u5 TO u5
    omdev + u5 / 2 TO omdev
    om16 + u4 / 2 TO om16
    GOTO estsv
estz
    0 TO om16
estsv
    u1 TO ox
    u2 TO oy
    qt TO ptht
    IF omdev > 45 THEN GOTO estlin
    IF om16 > 15 THEN GOTO estset
    IF om16 < -15 THEN GOTO estset
    0 TO sn
    256 TO cs
    RETURN
estlin
    0 TO sn
    256 TO cs
    RETURN
estset
    om16 * 9 / 32 TO u1
    u1 * u1 / 512 TO u2
    256 - u2 TO cs
    u1 TO sn
    RETURN

; ======================= main: movement =======================
; loop around the centre; classify the tracked robot; pick heading and speed
steer
    IF SPEED = 0 THEN
        IF FUEL > 0 THEN 0 - side TO side
    END
    IF trk > 0 THEN
        clock - ftime TO u1
        IF nfix < 6 THEN 99 TO u1
        IF u1 < 4 THEN
            fvx * fvx TO u1
            fvy * fvy + u1 TO u1
            fx / 16 TO u2
            fy / 16 TO u3
            IF u1 > 6400 THEN 0 TO u1
            IF u1 > 1600 THEN
                0 TO u4
                IF u2 > 45 THEN
                    IF u2 < 336 THEN
                        IF u3 > 45 THEN
                            IF u3 < 268 THEN 1 TO u4
                        END
                    END
                END
                IF fvx < 10 THEN
                    IF fvx > -10 THEN 0 TO u4
                END
                IF fvy < 10 THEN
                    IF fvy > -10 THEN 0 TO u4
                END
                IF u4 > 0 THEN fastc + 3 TO fastc
            ELSE
                fastc - 1 TO fastc
            END
            IF fastc < 0 THEN 0 TO fastc
            IF fastc > 40 THEN 40 TO fastc
        END
    END
    kR TO rtgt
    2 TO kg
    IF fastc > 2 THEN
        4 TO kg
        IF clock > rtnext THEN
            51 TO RANDOM
            RANDOM + 85 TO rtlast
            7 TO RANDOM
            RANDOM + 4 + clock TO rtnext
        END
        rtlast TO rtgt
    END
strtry
    cgen TO u1
    X - 190 TO X_CONV
    Y - 156 TO Y_CONV
    ANGLE_CONV TO ca
    DIST_CONV - rtgt * kg TO k
    IF cgen <> u1 THEN GOTO strtry
    IF k > 60 THEN 60 TO k
    IF k < -60 THEN -60 TO k
    IF side > 0 THEN
        ca + 90 + k TO dd
    ELSE
        ca + 270 - k TO dd
    END
    dd + 720 MOD 360 TO dd
    39 TO spd
    GOSUB walls
    IF FUEL < 400 THEN
        IF spd > 29 THEN 29 TO spd
    END
    IF FUEL < 200 THEN
        IF spd > 19 THEN 19 TO spd
    END
    IF FUEL < 120 THEN 9 TO spd
    IF dd <> DIRECTION THEN dd TO DIRECTION
    IF spd <> SPEED THEN spd TO SPEED
    RETURN

; reflect the heading off any wall we are close to and moving toward
walls
    IF X < 45 THEN
        IF dd > 180 THEN 360 - dd TO dd
    END
    IF X > 336 THEN
        IF dd < 180 THEN
            IF dd > 0 THEN 360 - dd TO dd
        END
    END
    IF Y < 45 THEN
        IF dd < 90 THEN 180 - dd TO dd
        IF dd > 270 THEN 540 - dd TO dd
    END
    IF Y > 268 THEN
        IF dd > 90 THEN
            IF dd < 270 THEN 540 - dd MOD 360 TO dd
        END
    END
    RETURN